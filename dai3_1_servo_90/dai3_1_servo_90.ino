// dai3_1_servo_90（第3回：サーボを、決めた角度に動かす）
// ボード：Arduino UNO R4 WiFi
// 配線：サーボの信号の線 → D9
//       サーボの電源の線（＋）→ 5V
//       サーボのGNDの線（−）→ GND
// 配線を変えるときは、必ずUSBケーブルを外してから行います。
// 「//」から右は人が読むための説明（コメント）です。実行されません。

#include <Servo.h>  // サーボを動かす機能を読み込む

Servo servo;        // 操作するサーボに名前を付ける

void setup() {      // 最初に1回実行する
  servo.attach(9);  // 信号線をつないだピンを指定
  servo.write(90);  // 目標の角度を90°にする
}

void loop() {       // 繰り返し実行する
}
